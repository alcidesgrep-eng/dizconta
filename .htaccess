# Dizconta — URLs limpias en Hostinger (Apache/LiteSpeed)
# /natura y /desconto/cupom-natura → index.html (el JS resuelve la ruta)
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ------------------------------------------------------------------
# CERO CACHE — cada actualización se ve al instante para todos.
# Cubre navegador, proxies intermedios y el cache propio del panel.
# El CDN "hcdn" de Hostinger puede igual ignorar esto para CSS/JS
# (bug documentado) — si un cambio no se refleja, renombrar el
# archivo (style.css → style2.css) sigue siendo el respaldo seguro.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, proxy-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
  Header unset ETag
  Header unset Last-Modified
</IfModule>
FileETag None

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

# LiteSpeed: apaga el cache de página propio del panel de Hostinger
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
